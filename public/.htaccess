# MesoNutrilift — cPanel (Apache / LiteSpeed) ayarları
# Bu dosya build sırasında out/ klasörüne kopyalanır; public_html'e diğer dosyalarla birlikte yüklenir.

Options -MultiViews -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Eski WordPress adresleri ---
  # Tema demosundan kalan sayfalar ana sayfaya yönlenir
  RewriteRule ^(home-v3|home-v4|home-v5|shop|cart|checkout|my-account)/?$ / [R=301,L]
  RewriteRule ^wp-sitemap.*\.xml$ /sitemap.xml [R=301,L]
  # Demo blog yazıları ve WordPress sistem yolları kalıcı olarak kaldırıldı (410)
  RewriteRule ^(hello-world|better-collaboration-by-bringing-des-into-the-code-review-process|everything-you-need-to-know-abe-transactional-email-know|how-improving-website-performan-can-help-save-the-planet|im-watching-concerns-monsters.*)/?$ - [G,L]
  RewriteRule ^(wp-admin|wp-includes|wp-login\.php|xmlrpc\.php|wp-json|feed|comments|author|category|tag)(/.*)?$ - [G,L]
  # NOT: /wp-content/ kuralı, görseller yerelleştirildikten sonra açılacak (şu an görseller eski siteden geliyor).
  # RewriteRule ^wp-content/ - [G,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Build'de içerik özetli adla üretilen dosyalar hiç değişmez: 1 yıl önbellek
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # HTML her zaman yeniden doğrulanır (yeni yayın anında görünsün)
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(avif|webp|jpe?g|png|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType text/plain .txt
</IfModule>
